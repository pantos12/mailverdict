# TypeSafe (Jev) — calibrated decisions. https://docs.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenRouter — used ONLY for human-readable explanations in the review band.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Shared secret that Copilot Studio / Power Automate must send as `x-api-key`.
MAILVERDICT_API_KEY=

# Decision thresholds (probability of phishing). Above HIGH => PHISHING, below LOW => LEGITIMATE.
VERDICT_HIGH_THRESHOLD=0.90
VERDICT_LOW_THRESHOLD=0.10
