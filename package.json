{
  "name": "mailverdict",
  "version": "0.1.0",
  "private": true,
  "description": "Forward an email, get a calibrated phishing verdict. Jev (TypeSafe System One) decides, an LLM explains only when needed. MCP server for Copilot Studio + REST for Power Automate.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "vercel dev",
    "eval": "tsx scripts/eval.ts",
    "analyze": "tsx scripts/analyze-file.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "mailparser": "^3.9.28",
    "tldts": "^7.4.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@vercel/node": "^13.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
